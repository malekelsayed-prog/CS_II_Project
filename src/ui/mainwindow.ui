  <property name="styleSheet">
   <string notr="true">
QMainWindow{
background:qlineargradient(x1:0,y1:0,x2:1,y2:1,
stop:0 #06111f, stop:1 #0a1830);
}

QFrame{
background:#081a31;
border:1px solid #18446f;
border-radius:18px;
}

QLabel{
color:white;
font-size:14px;
border:none;
background:transparent;
}

QPushButton{
background:#16b8d4;
color:white;
font-size:15px;
font-weight:bold;
border:none;
border-radius:14px;
}

QPushButton:hover{
background:#0ea5c0;
}

QPushButton#btnExit{
background:#ef4444;
}

QPushButton#btnExit:hover{
background:#dc2626;
}
 </string>
