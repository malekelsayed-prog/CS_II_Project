       <property name="text">
        <string>Department:</string>
       </property>
      </widget>
     </item>

     <item>
      <widget class="QComboBox" name="cmbDepartment"/>
     </item>

     <item>
      <widget class="QPushButton" name="btnRefresh">
       <property name="text">
        <string>Refresh</string>
       </property>
      </widget>
     </item>

    </layout>
   </item>

   <item>
    <widget class="QTableWidget" name="tableSchedule">
